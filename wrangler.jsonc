{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "santorini-online-v01",
  "main": "src/index.js",
  "compatibility_date": "2026-10-29",
  "durable_objects": {
    "bindings": [{"name":"ROOM","class_name":"SantoriniRoom"}]
  },
  "migrations": [{"tag":"v1","new_sqlite_classes":["SantoriniRoom"]}],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/api/*"]
  }
}
